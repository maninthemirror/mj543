---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../site.config';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const baseURL = import.meta.env.BASE_URL;
const withBase = (value: string) => {
  if (/^https?:\/\//.test(value)) return value;
  const base = baseURL.endsWith('/') ? baseURL : `${baseURL}/`;
  return value.startsWith('/') ? `${base}${value.slice(1)}` : `${base}${value}`;
};

const siteURL = new URL(withBase('/'), Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: siteURL,
  inLanguage: 'zh-Hant',
  publisher: {
    '@type': 'Person',
    name: AUTHOR_NAME,
  },
};
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  ogImage="/images/botdf30/feature2.jpg"
  ogType="website"
  structuredData={structuredData}
>
  <section>
    <h1>最新文章</h1>
    {posts.map((post) => {
      const slug = post.id.replace(/\.mdx?$/, '');
      return (
        <article class="card">
          <a href={withBase(`/${slug}/`)}>
            <img src={withBase(post.data.cover)} alt={post.data.coverAlt} loading="lazy" />
            <h2>{post.data.title}</h2>
          </a>
          <p>{post.data.description}</p>
        </article>
      );
    })}
  </section>
  <footer class="home-footer">
    <a href={withBase('/about/')}>About</a>
  </footer>
</BaseLayout>

<style>
  h1 { margin-bottom: 1.6rem; font-size: 1.6rem; }
  .card {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1rem;
    margin-bottom: 1rem;
  }
  .card a { color: var(--text); text-decoration: none; }
  .card h2 { margin: 0.9rem 0 0.3rem; font-size: 1.2rem; }
  .card p { margin: 0; color: var(--muted); }
  .home-footer {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }
</style>
