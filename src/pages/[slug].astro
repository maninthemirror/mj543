---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR_BIO, AUTHOR_NAME, SITE_TITLE } from '../site.config';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'posts'> };
const { post } = Astro.props;
const { Content } = await post.render();
const seoTitle = post.data.seoTitle ?? `${post.data.title} - ${SITE_TITLE}`;

const baseURL = import.meta.env.BASE_URL;
const withBase = (value: string) => {
  if (/^https?:\/\//.test(value)) return value;
  const base = baseURL.endsWith('/') ? baseURL : `${baseURL}/`;
  return value.startsWith('/') ? `${base}${value.slice(1)}` : `${base}${value}`;
};

const canonicalURL = new URL(withBase(`/${post.id.replace(/\.mdx?$/, '')}/`), Astro.site).toString();
const imageURL = new URL(withBase(post.data.ogImage), Astro.site).toString();
const aboutURL = new URL(withBase('/about/'), Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: [imageURL],
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: 'zh-Hant',
  mainEntityOfPage: canonicalURL,
  author: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    description: AUTHOR_BIO,
    url: aboutURL,
  },
  publisher: {
    '@type': 'Person',
    name: AUTHOR_NAME,
  },
};

---

<BaseLayout
  title={seoTitle}
  description={post.data.description}
  ogImage={post.data.ogImage}
  ogType="article"
  structuredData={structuredData}
>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      發布於 {post.data.pubDate.toLocaleDateString('zh-TW')}
    </p>
    <img src={withBase(post.data.cover)} alt={post.data.coverAlt} />
    <details class="toc" id="post-toc">
      <summary>文章大綱</summary>
      <ul id="post-toc-list"></ul>
    </details>
    <Content />
  </article>
</BaseLayout>

<script>
  const EXCLUDE_TEXT = '我們從MV來細品這首歌吧';
  const article = document.querySelector('article');
  const toc = document.querySelector('#post-toc');
  const list = document.querySelector('#post-toc-list');

  const slugify = (text) =>
    text
      .trim()
      .toLowerCase()
      .replace(/[^\p{L}\p{N}\s-]/gu, '')
      .replace(/\s+/g, '-');

  if (article && toc && list) {
    const headings = Array.from(article.querySelectorAll('h2, h3'))
      .map((el) => ({ el, text: (el.textContent || '').trim(), depth: Number(el.tagName[1]) }))
      .filter((h) => h.text && h.text !== EXCLUDE_TEXT);

    if (headings.length === 0) {
      toc.remove();
    } else {
      for (const { el, text } of headings) {
        if (!el.id) el.id = slugify(text);
      }

      let currentH2Li = null;
      let nested = null;

      for (const { el, text, depth } of headings) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${el.id}`;
        a.textContent = text;
        li.appendChild(a);

        if (depth === 2) {
          list.appendChild(li);
          currentH2Li = li;
          nested = null;
          continue;
        }

        if (!currentH2Li) {
          list.appendChild(li);
          continue;
        }

        if (!nested) {
          nested = document.createElement('ul');
          currentH2Li.appendChild(nested);
        }
        nested.appendChild(li);
      }
    }
  }
</script>

<style>
  .meta { color: var(--muted); margin-top: -0.3rem; }
  .toc {
    margin: 1rem 0 1.5rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--paper);
    color: #555;
    font-size: 0.92rem;
    font-weight: 400;
  }
  .toc summary {
    cursor: pointer;
    font-weight: 500;
    color: #444;
  }
  .toc ul {
    margin: 0.75rem 0 0;
    padding-left: 1.2rem;
  }
  .toc ul ul {
    margin-top: 0.3rem;
  }
  .toc a,
  .toc a:visited {
    color: #555;
    font-weight: 400;
  }
  .toc a:hover {
    color: #333;
  }
</style>
