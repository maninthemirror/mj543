---
import { SITE_TITLE } from '../site.config';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  structuredData,
} = Astro.props;

const baseURL = import.meta.env.BASE_URL;
const withBase = (value: string) => {
  if (/^https?:\/\//.test(value)) return value;
  const base = baseURL.endsWith('/') ? baseURL : `${baseURL}/`;
  return value.startsWith('/') ? `${base}${value.slice(1)}` : `${base}${value}`;
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(withBase(ogImage), Astro.site);
const structuredDataList = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL.toString()} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.toString()} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="canonical" href={canonicalURL.toString()} />
    {structuredDataList.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href={withBase('/')} class="brand">{SITE_TITLE}</a>
    </header>
    <main>
      <slot />
    </main>
    <button id="back-to-top" class="back-to-top" type="button" aria-label="回到最上方">↑</button>
    <script>
      const btn = document.getElementById('back-to-top');
      if (btn) {
        const toggle = () => {
          const show = window.scrollY > 420;
          btn.classList.toggle('is-visible', show);
        };
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        if (!target.classList.contains('details-close')) return;
        const details = target.closest('details');
        if (!details) return;
        details.open = false;
        const header = document.querySelector('.site-header');
        const headerHeight = header instanceof HTMLElement ? header.offsetHeight : 0;
        const top = window.scrollY + details.getBoundingClientRect().top - headerHeight - 50;
        window.scrollTo({ top, behavior: 'smooth' });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f8f7f4;
    --paper: #fff;
    --text: #1c1c1c;
    --muted: #666;
    --border: #e5e2db;
    --link: #8a1c34;
    --link-hover: #5e1224;
    --link-visited: #6b2f56;
    --max-width: 760px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: "Noto Serif TC", "PingFang TC", "Microsoft JhengHei", serif;
    background: radial-gradient(circle at top, #fff 0%, var(--bg) 45%);
    color: var(--text);
    line-height: 1.9;
  }

  .site-header {
    padding: 1.25rem 1rem;
    border-bottom: 1px solid var(--border);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(6px);
  }

  .brand {
    display: block;
    margin: 0 auto;
    max-width: var(--max-width);
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  img { max-width: 100%; height: auto; border-radius: 10px; }

  article p { margin: 1.1rem 0; }
  article h1{
    font-size : 1.6rem;
  }
  article h1, article h2, article h3, article h4, article h5, article h6 {
    line-height: 1.6;
    margin: 0 0 0.9rem;
    scroll-margin-top: 8.4rem;
  }
  article blockquote {
    margin: 1.4rem 0;
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 3px solid #b4a89a;
    color: #3c3a37;
  }
  article ul, article ol { padding-left: 1.4rem; }

  a {
    color: var(--link);
    text-decoration-color: color-mix(in srgb, var(--link) 55%, transparent);
    text-underline-offset: 0.13em;
  }

  a:hover {
    color: var(--link-hover);
    text-decoration-color: var(--link-hover);
  }

  a:visited {
    color: var(--link-visited);
  }

  .embed {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    margin: 1.4rem 0;
    background: #000;
  }

  .embed.youtube { padding-top: 56.25%; }
  .embed.spotify { padding-top: 26%; min-height: 152px; background: #121212; }

  .embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }



  article ul.references {
    font-size: 0.95rem;
    line-height: 1.65;
  }

  article ul.references li {
    margin: 0.3rem 0;
  }

  article ul.references a {
    overflow-wrap: anywhere;
    word-break: normal;
    text-wrap: pretty;
  }
  figure { margin: 1.6rem 0; }
  figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  figure.img-narrow img {
    max-width: 560px;
    width: 100%;
    margin: 0 auto;
    display: block;
  }

  article h2 + h3 {
    margin-top: 0.9rem;
  }

  article details {
    margin: 0.35rem 0 1.4rem;
    border-left: 2px solid var(--border);
    padding-left: 0.8rem;
  }

  article details > summary {
    cursor: pointer;
    color: #555;
    font-size: 0.95rem;
    font-weight: 500;
    margin: 0.2rem 0 0rem;
  }

  .details-close-wrap {
    margin: 1rem 0 0.2rem;
  }

  .details-close {
    border: 1px solid var(--border);
    background: #fff;
    color: #444;
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .details-close:hover {
    color: #111;
  }

  .back-to-top {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #fff;
    color: #444;
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
    z-index: 1100;
  }

  .back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover {
    color: #111;
  }

  @media (max-width: 640px) {
    main { padding-top: 1.2rem; }
    body { line-height: 1.8; }
    article h1, article h2, article h3, article h4, article h5, article h6 {
      scroll-margin-top: 7rem;
    }
    .back-to-top {
      right: 0.9rem;
      bottom: 0.9rem;
      width: 2.2rem;
      height: 2.2rem;
    }
  }
</style>
